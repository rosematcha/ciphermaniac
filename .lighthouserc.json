{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --outDir .cache/lighthouse-dist --port 4173 --strictPort",
      "startServerReadyPattern": "Local",
      "url": ["http://localhost:4173/", "http://localhost:4173/cards", "http://localhost:4173/trends"],
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "aggregationMethod": "median",
      "assertions": {
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 90000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 5000
          }
        ],
        "resource-summary:image:size": [
          "warn",
          {
            "maxNumericValue": 600000
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 1500000
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
